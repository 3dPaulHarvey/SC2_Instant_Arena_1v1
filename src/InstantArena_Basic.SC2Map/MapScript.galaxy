include "TriggerLibs/NativeLib"

// Instant Arena v0.1.7 - researched, battle-ready armies at 1-1.
// The build script embeds this code into the map's editable Custom Script element.

const int ARENA_PLAYER = 1;
const int ARENA_PLAYER_TWO = 2;
const int ARENA_ENEMY = 15;
const int ARENA_LIMIT = 100;
const int ARENA_FAVORITES = 3;

bool arenaHumanMatch = false;
unitgroup[16] arenaArmy;
point[16] arenaSpawnPoint;
int[3] arenaDialog;
int[3] arenaRaceMenu;
int[3] arenaUnitMenu;
string[3] arenaSelectedUnit;
string[3][3] arenaFavoriteUnit;
int[3][3] arenaFavoriteLabel;
int[3][3][3] arenaFavoriteButton;
int[3] arenaEnemyButton;
int[3] arenaClearButton;
int[3] arenaResetButton;
int[3] arenaStatusLabel;
int arenaSpeedSlider;
int[3] arenaSpeedLabel;
int arenaSpeedIndex = -1;

bool ArenaIsHumanPlayer (int player) {
    return player == ARENA_PLAYER || (arenaHumanMatch && player == ARENA_PLAYER_TWO);
}

int ArenaOpponent (int player) {
    if (arenaHumanMatch) {
        return 3 - player;
    }
    return ARENA_ENEMY;
}

void ArenaRefreshStatusForPlayer (int player) {
    string status;
    status = "Yours: " + IntToString(UnitGroupCount(arenaArmy[player], c_unitCountAlive));
    status = status + " / 100     Enemy: ";
    status = status + IntToString(UnitGroupCount(arenaArmy[ArenaOpponent(player)], c_unitCountAlive)) + " / 100";
    libNtve_gf_SetDialogItemText(arenaStatusLabel[player], StringToText(status), PlayerGroupSingle(player));
}

void ArenaRefreshStatus () {
    ArenaRefreshStatusForPlayer(ARENA_PLAYER);
    if (arenaHumanMatch) {
        ArenaRefreshStatusForPlayer(ARENA_PLAYER_TWO);
    }
}

int ArenaButton (int player, string caption, int y) {
    int control;
    control = DialogControlCreate(arenaDialog[player], c_triggerControlTypeButton);
    DialogControlSetSize(control, PlayerGroupSingle(player), 300, 38);
    DialogControlSetPosition(control, PlayerGroupSingle(player), c_anchorTopLeft, 20, y);
    libNtve_gf_SetDialogItemText(control, StringToText(caption), PlayerGroupSingle(player));
    return control;
}

int ArenaMenu (int player, int y) {
    int control;
    control = DialogControlCreate(arenaDialog[player], c_triggerControlTypePulldown);
    // SC2's pulldown frame needs more vertical padding than a plain button.
    DialogControlSetSize(control, PlayerGroupSingle(player), 300, 52);
    DialogControlSetPosition(control, PlayerGroupSingle(player), c_anchorTopLeft, 20, y);
    return control;
}

// Roster indices start at 1. The unit pulldown reserves item 1 for its prompt.
// Standard multiplayer units in their normal mobile form; no custom assets.
int ArenaUnitCount (int race) {
    if (race == 1) { return 17; }
    if (race == 2) { return 18; }
    if (race == 3) { return 17; }
    return 0;
}

string ArenaUnitType (int race, int index) {
    if (race == 1) {
        if (index == 1) { return "Marine"; }
        if (index == 2) { return "Marauder"; }
        if (index == 3) { return "Reaper"; }
        if (index == 4) { return "Ghost"; }
        if (index == 5) { return "Hellion"; }
        if (index == 6) { return "HellionTank"; }
        if (index == 7) { return "WidowMine"; }
        if (index == 8) { return "Cyclone"; }
        if (index == 9) { return "SiegeTank"; }
        if (index == 10) { return "Thor"; }
        if (index == 11) { return "VikingFighter"; }
        if (index == 12) { return "Medivac"; }
        if (index == 13) { return "Liberator"; }
        if (index == 14) { return "Banshee"; }
        if (index == 15) { return "Raven"; }
        if (index == 16) { return "Battlecruiser"; }
        if (index == 17) { return "SCV"; }
    }
    else if (race == 2) {
        if (index == 1) { return "Zealot"; }
        if (index == 2) { return "Stalker"; }
        if (index == 3) { return "Sentry"; }
        if (index == 4) { return "Adept"; }
        if (index == 5) { return "HighTemplar"; }
        if (index == 6) { return "DarkTemplar"; }
        if (index == 7) { return "Archon"; }
        if (index == 8) { return "Immortal"; }
        if (index == 9) { return "Colossus"; }
        if (index == 10) { return "Disruptor"; }
        if (index == 11) { return "Observer"; }
        if (index == 12) { return "WarpPrism"; }
        if (index == 13) { return "Phoenix"; }
        if (index == 14) { return "VoidRay"; }
        if (index == 15) { return "Oracle"; }
        if (index == 16) { return "Tempest"; }
        if (index == 17) { return "Carrier"; }
        if (index == 18) { return "Probe"; }
    }
    else if (race == 3) {
        if (index == 1) { return "Zergling"; }
        if (index == 2) { return "Baneling"; }
        if (index == 3) { return "Roach"; }
        if (index == 4) { return "Ravager"; }
        if (index == 5) { return "Hydralisk"; }
        if (index == 6) { return "LurkerMP"; }
        if (index == 7) { return "Infestor"; }
        if (index == 8) { return "SwarmHostMP"; }
        if (index == 9) { return "Ultralisk"; }
        if (index == 10) { return "Queen"; }
        if (index == 11) { return "Overlord"; }
        if (index == 12) { return "Overseer"; }
        if (index == 13) { return "Mutalisk"; }
        if (index == 14) { return "Corruptor"; }
        if (index == 15) { return "BroodLord"; }
        if (index == 16) { return "Viper"; }
        if (index == 17) { return "Drone"; }
    }
    return "";
}

string ArenaSelectedUnitType (int player) {
    return arenaSelectedUnit[player];
}

void ArenaRefreshSelection (int player) {
    string unitType;
    unitType = ArenaSelectedUnitType(player);
    if (unitType == "") {
        return;
    }
    if (!arenaHumanMatch) {
        libNtve_gf_SetDialogItemText(arenaEnemyButton[player], StringToText("Spawn Enemy ") + UnitTypeGetName(unitType), PlayerGroupSingle(player));
    }
}

int ArenaFavoriteQuantity (int buttonIndex) {
    if (buttonIndex == 0) { return 10; }
    if (buttonIndex == 1) { return 5; }
    if (buttonIndex == 2) { return 1; }
    return 0;
}

void ArenaRefreshFavorites (int player) {
    int slot;
    int buttonIndex;
    slot = 0;
    while (slot < ARENA_FAVORITES) {
        libNtve_gf_SetDialogItemText(arenaFavoriteLabel[player][slot],
            UnitTypeGetName(arenaFavoriteUnit[player][slot]), PlayerGroupSingle(player));
        buttonIndex = 0;
        while (buttonIndex < 3) {
            DialogControlSetPropertyAsText(arenaFavoriteButton[player][slot][buttonIndex],
                c_triggerControlPropertyTooltip, PlayerGroupSingle(player),
                StringToText("Spawn " + IntToString(ArenaFavoriteQuantity(buttonIndex)) + " ")
                    + UnitTypeGetName(arenaFavoriteUnit[player][slot]));
            buttonIndex += 1;
        }
        slot += 1;
    }
}

void ArenaAddFavorite (int player, string unitType) {
    int slot;
    if (!ArenaIsHumanPlayer(player) || unitType == "") {
        return;
    }
    // Oldest is at the top; every explicit pick joins the bottom of the queue.
    slot = 0;
    while (slot < ARENA_FAVORITES - 1) {
        arenaFavoriteUnit[player][slot] = arenaFavoriteUnit[player][slot + 1];
        slot += 1;
    }
    arenaFavoriteUnit[player][ARENA_FAVORITES - 1] = unitType;
    ArenaRefreshFavorites(player);
}

void ArenaFillUnitMenu (int player) {
    int race;
    int index;
    race = DialogControlGetSelectedItem(arenaRaceMenu[player], player);
    if (race < 1 || race > 3) {
        return;
    }
    DialogControlRemoveAllItems(arenaUnitMenu[player], PlayerGroupSingle(player));
    DialogControlAddItem(arenaUnitMenu[player], PlayerGroupSingle(player), StringToText("Add unit to favorites..."));
    index = 1;
    while (index <= ArenaUnitCount(race)) {
        DialogControlAddItem(arenaUnitMenu[player], PlayerGroupSingle(player), UnitTypeGetName(ArenaUnitType(race, index)));
        index += 1;
    }
    arenaSelectedUnit[player] = ArenaUnitType(race, 1);
    DialogControlSelectItem(arenaUnitMenu[player], PlayerGroupSingle(player), 1);
    ArenaRefreshSelection(player);
}

bool ArenaMenuChanged (bool testConds, bool runActions) {
    int player;
    int index;
    string unitType;
    player = EventPlayer();
    if (!runActions || !ArenaIsHumanPlayer(player)) {
        return true;
    }
    if (EventDialogControl() == arenaRaceMenu[player]) {
        ArenaFillUnitMenu(player);
    }
    else if (EventDialogControl() == arenaUnitMenu[player]) {
        index = DialogControlGetSelectedItem(arenaUnitMenu[player], player) - 1;
        unitType = ArenaUnitType(DialogControlGetSelectedItem(arenaRaceMenu[player], player), index);
        if (unitType == "") {
            return true;
        }
        arenaSelectedUnit[player] = unitType;
        ArenaAddFavorite(player, unitType);
        ArenaRefreshSelection(player);
        // Reset to the prompt so choosing the same unit again is a new event.
        DialogControlSelectItem(arenaUnitMenu[player], PlayerGroupSingle(player), 1);
    }
    return true;
}

string ArenaSpeedName (int speed) {
    if (speed == c_gameSpeedSlower) { return "Slower"; }
    if (speed == c_gameSpeedSlow) { return "Slow"; }
    if (speed == c_gameSpeedNormal) { return "Normal"; }
    if (speed == c_gameSpeedFast) { return "Fast"; }
    if (speed == c_gameSpeedFaster) { return "Faster"; }
    return "Unknown";
}

void ArenaRefreshSpeed () {
    int speed;
    speed = GameGetSpeedValue();
    // Read back the engine's actual speed before updating the label and slider.
    arenaSpeedIndex = speed;
    libNtve_gf_SetDialogItemText(arenaSpeedLabel[ARENA_PLAYER],
        StringToText("Game speed: " + ArenaSpeedName(speed)), PlayerGroupSingle(ARENA_PLAYER));
    if (arenaHumanMatch) {
        libNtve_gf_SetDialogItemText(arenaSpeedLabel[ARENA_PLAYER_TWO],
            StringToText("Game speed: " + ArenaSpeedName(speed)), PlayerGroupSingle(ARENA_PLAYER_TWO));
    }
    if (DialogControlGetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyValue, ARENA_PLAYER) != IntToFixed(speed)) {
        DialogControlSetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyValue,
            PlayerGroupSingle(ARENA_PLAYER), IntToFixed(speed));
    }
}

void ArenaSetSpeed (int speed) {
    if (speed < c_gameSpeedSlower) { speed = c_gameSpeedSlower; }
    if (speed > c_gameSpeedFaster) { speed = c_gameSpeedFaster; }
    if (GameGetSpeedValue() != speed) {
        GameSetSpeedValue(speed);
    }
    ArenaRefreshSpeed();
}

bool ArenaSpeedChanged (bool testConds, bool runActions) {
    int speed;
    if (!runActions || EventPlayer() != ARENA_PLAYER || EventDialogControl() != arenaSpeedSlider) {
        return true;
    }
    // The engine has five discrete presets. Snap dragging to the nearest one.
    speed = FixedToInt(DialogControlGetPropertyAsFixed(arenaSpeedSlider,
        c_triggerControlPropertyValue, ARENA_PLAYER) + 0.5);
    ArenaSetSpeed(speed);
    return true;
}

bool ArenaSpeedSync (bool testConds, bool runActions) {
    // Keep the control accurate if speed is changed through SC2's own controls.
    if (runActions && GameGetSpeedValue() != arenaSpeedIndex) {
        ArenaRefreshSpeed();
    }
    return true;
}

void ArenaClearGroup (unitgroup army) {
    unit target;
    while (UnitGroupCount(army, c_unitCountAll) > 0) {
        target = UnitGroupUnit(army, 1);
        UnitGroupRemove(army, target);
        UnitRemove(target);
    }
}

void ArenaGrantUpgrade (int player, string upgrade) {
    if (upgrade != "" && CatalogEntryIsValid(c_gameCatalogUpgrade, upgrade)) {
        // Set, never accumulate: repeat setup cannot turn 1-1 into 2-2.
        libNtve_gf_SetUpgradeLevelForPlayer(player, upgrade, 1);
    }
}

void ArenaGrantResearch (int player, string structure) {
    int card;
    int button;
    string layout;
    string field;
    string commandText;
    string ability;
    string upgrade;
    abilcmd command;
    // Read the active multiplayer command cards, not every historical upgrade
    // left in the catalog. This also follows research changes in SC2 patches.
    card = 0;
    while (card < CatalogFieldValueCount(c_gameCatalogUnit, structure, "CardLayouts", player)) {
        layout = "CardLayouts[" + IntToString(card) + "].LayoutButtons";
        button = 0;
        while (button < CatalogFieldValueCount(c_gameCatalogUnit, structure, layout, player)) {
            field = layout + "[" + IntToString(button) + "]";
            if (CatalogFieldValueGet(c_gameCatalogUnit, structure, field + ".Type", player) == "AbilCmd") {
                commandText = CatalogFieldValueGet(c_gameCatalogUnit, structure, field + ".AbilCmd", player);
                if (commandText != "") {
                    command = StringToAbilCmd(commandText);
                    ability = AbilityCommandGetAbility(command);
                    if (CatalogEntryIsValid(c_gameCatalogAbil, ability)
                        && CatalogEntryScope(c_gameCatalogAbil, ability) == "CAbilResearch") {
                        field = "InfoArray[" + IntToString(AbilityCommandGetCommand(command)) + "].Upgrade";
                        upgrade = CatalogFieldValueGet(c_gameCatalogAbil, ability, field, player);
                        ArenaGrantUpgrade(player, upgrade);
                    }
                }
            }
            button += 1;
        }
        card += 1;
    }
}

void ArenaPreparePlayer (int player) {
    // Every race is enabled because favorites can contain mixed-race armies.
    ArenaGrantUpgrade(player, "TerranInfantryWeaponsLevel1");
    ArenaGrantUpgrade(player, "TerranInfantryArmorsLevel1");
    ArenaGrantUpgrade(player, "TerranVehicleWeaponsLevel1");
    ArenaGrantUpgrade(player, "TerranShipWeaponsLevel1");
    // Combined plating already covers both; separate armor upgrades would stack.
    ArenaGrantUpgrade(player, "TerranVehicleAndShipArmorsLevel1");
    ArenaGrantUpgrade(player, "ProtossGroundWeaponsLevel1");
    ArenaGrantUpgrade(player, "ProtossGroundArmorsLevel1");
    ArenaGrantUpgrade(player, "ProtossAirWeaponsLevel1");
    ArenaGrantUpgrade(player, "ProtossAirArmorsLevel1");
    ArenaGrantUpgrade(player, "ProtossShieldsLevel1");
    ArenaGrantUpgrade(player, "ZergMeleeWeaponsLevel1");
    ArenaGrantUpgrade(player, "ZergMissileWeaponsLevel1");
    ArenaGrantUpgrade(player, "ZergGroundArmorsLevel1");
    ArenaGrantUpgrade(player, "ZergFlyerWeaponsLevel1");
    ArenaGrantUpgrade(player, "ZergFlyerArmorsLevel1");

    // Only unit-specialist research structures: exclude the weapon/armor
    // research buildings so their level 2 and 3 buttons are never granted.
    ArenaGrantResearch(player, "BarracksTechLab");
    ArenaGrantResearch(player, "FactoryTechLab");
    ArenaGrantResearch(player, "StarportTechLab");
    ArenaGrantResearch(player, "GhostAcademy");
    ArenaGrantResearch(player, "FusionCore");
    ArenaGrantResearch(player, "TwilightCouncil");
    ArenaGrantResearch(player, "TemplarArchive");
    ArenaGrantResearch(player, "DarkShrine");
    ArenaGrantResearch(player, "RoboticsBay");
    ArenaGrantResearch(player, "FleetBeacon");
    ArenaGrantResearch(player, "Hatchery");
    ArenaGrantResearch(player, "Lair");
    ArenaGrantResearch(player, "Hive");
    ArenaGrantResearch(player, "SpawningPool");
    ArenaGrantResearch(player, "BanelingNest");
    ArenaGrantResearch(player, "RoachWarren");
    ArenaGrantResearch(player, "HydraliskDen");
    ArenaGrantResearch(player, "LurkerDenMP");
    ArenaGrantResearch(player, "InfestationPit");
    ArenaGrantResearch(player, "UltraliskCavern");

    // The sandbox has no Armory. Allow the two Hellion modes without disabling
    // other requirements (magazine capacity, spell costs, etc. still apply).
    CatalogFieldValueSet(c_gameCatalogAbil, "MorphToHellion", "CmdButtonArray[Execute].Requirements", player, "");
    CatalogFieldValueSet(c_gameCatalogAbil, "MorphToHellionTank", "CmdButtonArray[Execute].Requirements", player, "");
    // Carriers can rebuild lost interceptors in an arena with no economy.
    CatalogFieldValueSet(c_gameCatalogAbil, "CarrierHangar", "InfoArray[Ammo1].Resource[Minerals]", player, "0");
}

void ArenaPrepareUnit (unit spawned) {
    int capacity;
    int missing;
    UnitSetPropertyFixed(spawned, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(spawned, c_unitPropShieldsPercent, 100.0);
    UnitSetPropertyFixed(spawned, c_unitPropEnergyPercent, 100.0);
    if (UnitAbilityExists(spawned, "CarrierHangar")) {
        capacity = StringToInt(CatalogFieldValueGet(c_gameCatalogAbil, "CarrierHangar", "MaxCount", UnitGetOwner(spawned)));
        missing = capacity - UnitMagazineCount(spawned, "CarrierHangar");
        if (missing > 0) {
            UnitMagazineArm(spawned, AbilityCommand("CarrierHangar", 0), missing);
        }
    }
}

point ArenaFormationPoint (int owner, int index, int quantity) {
    int rows;
    int column;
    fixed x;
    fixed y;
    rows = quantity;
    if (rows > 5) { rows = 5; }
    column = 0;
    if (index >= 5) { column = 1; }
    x = PointGetX(arenaSpawnPoint[owner]);
    y = PointGetY(arenaSpawnPoint[owner]) + IntToFixed(index % 5) * 2.0 - IntToFixed(rows - 1);
    // Mirror two files behind each side's front line, facing the opponent.
    if (owner == ARENA_PLAYER) { x -= IntToFixed(column) * 2.0; }
    else { x += IntToFixed(column) * 2.0; }
    return Point(x, y);
}

void ArenaSpawn (int player, int owner, string unitType, int quantity) {
    unitgroup army;
    unitgroup created;
    unit spawned;
    point spawn;
    fixed facing;
    int count;
    if (!ArenaIsHumanPlayer(player)) {
        return;
    }
    // Human players can create only their own units. Solo keeps the enemy button.
    if (owner != player && (arenaHumanMatch || player != ARENA_PLAYER || owner != ARENA_ENEMY)) {
        return;
    }
    if (unitType == "" || quantity < 1 || quantity > 10) {
        return;
    }
    army = arenaArmy[owner];
    spawn = arenaSpawnPoint[owner];
    facing = 180.0;
    if (owner == ARENA_PLAYER) { facing = 0.0; }
    if (UnitGroupCount(army, c_unitCountAlive) >= ARENA_LIMIT) {
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle,
            StringToText("100 living units on this side. Clear an army or fight to make room."));
        return;
    }
    count = 0;
    // Create individually for normal placement and stop exactly at the living cap.
    while (count < quantity && UnitGroupCount(army, c_unitCountAlive) < ARENA_LIMIT) {
        spawn = ArenaFormationPoint(owner, count, quantity);
        created = UnitCreate(1, unitType, 0, owner, spawn, facing);
        spawned = UnitGroupUnit(created, 1);
        if (spawned == null) {
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle,
                StringToText("No room here. Move units away or clear an army."));
            ArenaRefreshStatus();
            return;
        }
        ArenaPrepareUnit(spawned);
        UnitGroupAdd(army, spawned);
        if (!arenaHumanMatch && owner == ARENA_ENEMY) {
            if (UnitAbilityExists(spawned, "attack")) {
                UnitIssueOrder(spawned,
                    OrderTargetingPoint(AbilityCommand("attack", 0), arenaSpawnPoint[ARENA_PLAYER]), c_orderQueueReplace);
            }
            else if (UnitAbilityExists(spawned, "move")) {
                // Transports, detectors, and other support units cannot attack.
                UnitIssueOrder(spawned,
                    OrderTargetingPoint(AbilityCommand("move", 0), arenaSpawnPoint[ARENA_PLAYER]), c_orderQueueReplace);
            }
        }
        count += 1;
    }
    ArenaRefreshStatus();
}

bool ArenaButtonClicked (bool testConds, bool runActions) {
    int player;
    int control;
    int slot;
    int buttonIndex;
    player = EventPlayer();
    if (!runActions || !ArenaIsHumanPlayer(player)) {
        return true;
    }
    control = EventDialogControl();
    slot = 0;
    while (slot < ARENA_FAVORITES) {
        buttonIndex = 0;
        while (buttonIndex < 3) {
            if (control == arenaFavoriteButton[player][slot][buttonIndex]) {
                ArenaSpawn(player, player, arenaFavoriteUnit[player][slot], ArenaFavoriteQuantity(buttonIndex));
                return true;
            }
            buttonIndex += 1;
        }
        slot += 1;
    }
    if (!arenaHumanMatch && control == arenaEnemyButton[player]) {
        ArenaSpawn(player, ARENA_ENEMY, ArenaSelectedUnitType(player), 1);
    }
    else if (control == arenaClearButton[player]) {
        ArenaClearGroup(arenaArmy[player]);
        ArenaRefreshStatus();
    }
    else if (!arenaHumanMatch && control == arenaResetButton[player]) {
        ArenaClearGroup(arenaArmy[ARENA_PLAYER]);
        ArenaClearGroup(arenaArmy[ARENA_ENEMY]);
        ArenaRefreshStatus();
    }
    return true;
}

bool ArenaUnitDied (bool testConds, bool runActions) {
    unit target;
    if (!runActions) {
        return true;
    }
    target = EventUnit();
    if (UnitGroupHasUnit(arenaArmy[ARENA_PLAYER], target)
        || UnitGroupHasUnit(arenaArmy[ARENA_PLAYER_TWO], target)
        || UnitGroupHasUnit(arenaArmy[ARENA_ENEMY], target)) {
        UnitGroupRemove(arenaArmy[ARENA_PLAYER], target);
        UnitGroupRemove(arenaArmy[ARENA_PLAYER_TWO], target);
        UnitGroupRemove(arenaArmy[ARENA_ENEMY], target);
        ArenaRefreshStatus();
        // Remove the dead unit handle so long sessions do not accumulate corpses.
        UnitRemove(target);
    }
    return true;
}

void ArenaCreatePanel (int player) {
    int titleLabel;
    int helpLabel;
    int favoritesTitle;
    int favoritesHelp;
    int slotLabel;
    int slot;
    int buttonIndex;
    int rowY;
    string slotCaption;
    int speedHelpLabel;
    int helpY;
    int speedY;
    int panelHeight;
    trigger buttonTrigger;
    trigger menuTrigger;
    trigger speedTrigger;

    panelHeight = 904;
    helpY = 760;
    if (arenaHumanMatch) {
        panelHeight = 816;
        helpY = 672;
    }
    speedY = helpY + 36;
    arenaDialog[player] = DialogCreate(340, panelHeight, c_anchorTopLeft, 14, 14, false);
    titleLabel = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(titleLabel, PlayerGroupSingle(player), 300, 24);
    DialogControlSetPosition(titleLabel, PlayerGroupSingle(player), c_anchorTopLeft, 20, 16);
    if (arenaHumanMatch) {
        libNtve_gf_SetDialogItemText(titleLabel, StringToText("INSTANT ARENA v0.1.7 - 1V1"), PlayerGroupSingle(player));
    }
    else {
        libNtve_gf_SetDialogItemText(titleLabel, StringToText("INSTANT ARENA v0.1.7 - SOLO"), PlayerGroupSingle(player));
    }

    arenaStatusLabel[player] = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(arenaStatusLabel[player], PlayerGroupSingle(player), 300, 24);
    DialogControlSetPosition(arenaStatusLabel[player], PlayerGroupSingle(player), c_anchorTopLeft, 20, 42);
    arenaRaceMenu[player] = ArenaMenu(player, 72);
    DialogControlAddItem(arenaRaceMenu[player], PlayerGroupSingle(player), StringToText("Terran"));
    DialogControlAddItem(arenaRaceMenu[player], PlayerGroupSingle(player), StringToText("Protoss"));
    DialogControlAddItem(arenaRaceMenu[player], PlayerGroupSingle(player), StringToText("Zerg"));
    DialogControlSelectItem(arenaRaceMenu[player], PlayerGroupSingle(player), 1);
    arenaUnitMenu[player] = ArenaMenu(player, 132);
    favoritesTitle = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(favoritesTitle, PlayerGroupSingle(player), 300, 24);
    DialogControlSetPosition(favoritesTitle, PlayerGroupSingle(player), c_anchorTopLeft, 20, 196);
    libNtve_gf_SetDialogItemText(favoritesTitle, StringToText("FAVORITES"), PlayerGroupSingle(player));
    favoritesHelp = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(favoritesHelp, PlayerGroupSingle(player), 300, 24);
    DialogControlSetPosition(favoritesHelp, PlayerGroupSingle(player), c_anchorTopLeft, 20, 222);
    libNtve_gf_SetDialogItemText(favoritesHelp, StringToText("1-1 + shields | All unit research"), PlayerGroupSingle(player));
    DialogControlSetPropertyAsText(favoritesHelp, c_triggerControlPropertyTooltip, PlayerGroupSingle(player),
        StringToText("New picks replace the oldest favorite. Units spawn with full health, shields and energy. Use abilities from their command cards; normal costs and cooldowns apply."));
    arenaFavoriteUnit[player][0] = "Marine";
    arenaFavoriteUnit[player][1] = "VoidRay";
    arenaFavoriteUnit[player][2] = "Queen";
    slot = 0;
    while (slot < ARENA_FAVORITES) {
        rowY = 250 + slot * 122;
        slotCaption = "2";
        if (slot == 0) { slotCaption = "1 - OLDEST"; }
        if (slot == 2) { slotCaption = "3 - NEWEST"; }
        slotLabel = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
        DialogControlSetSize(slotLabel, PlayerGroupSingle(player), 222, 20);
        DialogControlSetPosition(slotLabel, PlayerGroupSingle(player), c_anchorTopLeft, 26, rowY + 6);
        libNtve_gf_SetDialogItemText(slotLabel, StringToText(slotCaption), PlayerGroupSingle(player));
        arenaFavoriteLabel[player][slot] = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
        DialogControlSetSize(arenaFavoriteLabel[player][slot], PlayerGroupSingle(player), 222, 28);
        DialogControlSetPosition(arenaFavoriteLabel[player][slot], PlayerGroupSingle(player), c_anchorTopLeft, 26, rowY + 34);
        buttonIndex = 0;
        while (buttonIndex < 3) {
            arenaFavoriteButton[player][slot][buttonIndex] = DialogControlCreate(arenaDialog[player], c_triggerControlTypeButton);
            DialogControlSetSize(arenaFavoriteButton[player][slot][buttonIndex], PlayerGroupSingle(player), 64, 38);
            DialogControlSetPosition(arenaFavoriteButton[player][slot][buttonIndex], PlayerGroupSingle(player),
                c_anchorTopLeft, 256, rowY + buttonIndex * 38);
            libNtve_gf_SetDialogItemText(arenaFavoriteButton[player][slot][buttonIndex],
                StringToText(IntToString(ArenaFavoriteQuantity(buttonIndex))), PlayerGroupSingle(player));
            buttonIndex += 1;
        }
        slot += 1;
    }
    ArenaRefreshFavorites(player);
    if (arenaHumanMatch) {
        arenaClearButton[player] = ArenaButton(player, "Clear My Army", 626);
    }
    else {
        arenaEnemyButton[player] = ArenaButton(player, "Spawn Enemy Marine", 626);
        arenaClearButton[player] = ArenaButton(player, "Clear My Army", 670);
        arenaResetButton[player] = ArenaButton(player, "Reset Arena", 714);
    }
    ArenaFillUnitMenu(player);
    helpLabel = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(helpLabel, PlayerGroupSingle(player), 300, 26);
    DialogControlSetPosition(helpLabel, PlayerGroupSingle(player), c_anchorTopLeft, 20, helpY);
    if (arenaHumanMatch) {
        libNtve_gf_SetDialogItemText(helpLabel, StringToText("Select units to move or attack."), PlayerGroupSingle(player));
    }
    else {
        libNtve_gf_SetDialogItemText(helpLabel, StringToText("Use 10 / 5 / 1 beside a favorite to spawn."), PlayerGroupSingle(player));
    }

    arenaSpeedLabel[player] = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(arenaSpeedLabel[player], PlayerGroupSingle(player), 300, 24);
    DialogControlSetPosition(arenaSpeedLabel[player], PlayerGroupSingle(player), c_anchorTopLeft, 20, speedY);
    speedHelpLabel = DialogControlCreate(arenaDialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(speedHelpLabel, PlayerGroupSingle(player), 300, 24);
    if (player == ARENA_PLAYER) {
        arenaSpeedSlider = DialogControlCreate(arenaDialog[player], c_triggerControlTypeSlider);
        DialogControlSetSize(arenaSpeedSlider, PlayerGroupSingle(player), 300, 32);
        DialogControlSetPosition(arenaSpeedSlider, PlayerGroupSingle(player), c_anchorTopLeft, 20, speedY + 32);
        DialogControlSetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyMinValue,
            PlayerGroupSingle(player), IntToFixed(c_gameSpeedSlower));
        DialogControlSetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyMaxValue,
            PlayerGroupSingle(player), IntToFixed(c_gameSpeedFaster));
        DialogControlSetPropertyAsText(arenaSpeedSlider, c_triggerControlPropertyTooltip,
            PlayerGroupSingle(player), StringToText("Changes game speed immediately for the whole match."));
        DialogControlSetPosition(speedHelpLabel, PlayerGroupSingle(player), c_anchorTopLeft, 20, speedY + 72);
        libNtve_gf_SetDialogItemText(speedHelpLabel, StringToText("Left: Slower   Right: Faster"), PlayerGroupSingle(player));
        speedTrigger = TriggerCreate("ArenaSpeedChanged");
        TriggerAddEventDialogControl(speedTrigger, player, arenaSpeedSlider, c_triggerControlEventTypeValueChanged);
    }
    else {
        DialogControlSetPosition(speedHelpLabel, PlayerGroupSingle(player), c_anchorTopLeft, 20, speedY + 32);
        libNtve_gf_SetDialogItemText(speedHelpLabel, StringToText("Player 1 controls game speed."), PlayerGroupSingle(player));
    }
    DialogSetVisible(arenaDialog[player], PlayerGroupSingle(player), true);

    buttonTrigger = TriggerCreate("ArenaButtonClicked");
    TriggerAddEventDialogControl(buttonTrigger, player, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    menuTrigger = TriggerCreate("ArenaMenuChanged");
    TriggerAddEventDialogControl(menuTrigger, player, arenaRaceMenu[player], c_triggerControlEventTypeSelectionChanged);
    TriggerAddEventDialogControl(menuTrigger, player, arenaUnitMenu[player], c_triggerControlEventTypeSelectionChanged);
}

void ArenaInit () {
    int player;
    trigger speedSyncTrigger;
    trigger deathTrigger;

    // Lobby state is synchronized; choose the mode once for every game client.
    arenaHumanMatch = PlayerType(ARENA_PLAYER_TWO) == c_playerTypeUser
        && PlayerStatus(ARENA_PLAYER_TWO) == c_playerStatusActive;
    arenaArmy[ARENA_PLAYER] = UnitGroupEmpty();
    arenaArmy[ARENA_PLAYER_TWO] = UnitGroupEmpty();
    arenaArmy[ARENA_ENEMY] = UnitGroupEmpty();
    arenaSpawnPoint[ARENA_PLAYER] = Point(9.0, 16.0);
    arenaSpawnPoint[ARENA_PLAYER_TWO] = Point(23.0, 16.0);
    arenaSpawnPoint[ARENA_ENEMY] = Point(23.0, 16.0);

    // Run before any menus can spawn units, equally for both human slots and AI.
    ArenaPreparePlayer(ARENA_PLAYER);
    ArenaPreparePlayer(ARENA_PLAYER_TWO);
    ArenaPreparePlayer(ARENA_ENEMY);

    // Deliberately omit melee initialization: no starting economy or defeat rules.
    if (arenaHumanMatch) {
        libNtve_gf_SetAlliance(ARENA_PLAYER, ARENA_PLAYER_TWO, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(ARENA_PLAYER_TWO, ARENA_PLAYER, libNtve_ge_AllianceSetting_Enemy);
    }
    else {
        libNtve_gf_SetAlliance(ARENA_PLAYER, ARENA_ENEMY, libNtve_ge_AllianceSetting_Enemy);
    }
    player = ARENA_PLAYER;
    while (player <= ARENA_PLAYER_TWO) {
        if (ArenaIsHumanPlayer(player)) {
            VisRevealArea(player, RegionEntireMap(), 0.0, false);
            CameraPan(player, Point(16.0, 16.0), 0.0, 0.0, 10.0, false);
            ArenaCreatePanel(player);
        }
        player += 1;
    }
    GameSetSpeedLocked(false);
    GameSetSpeedValueMinimum(c_gameSpeedSlower);
    ArenaSetSpeed(c_gameSpeedNormal);
    ArenaRefreshStatus();
    speedSyncTrigger = TriggerCreate("ArenaSpeedSync");
    TriggerAddEventTimePeriodic(speedSyncTrigger, 0.5, c_timeReal);
    deathTrigger = TriggerCreate("ArenaUnitDied");
    TriggerAddEventUnitDied(deathTrigger, null);
}


bool ArenaMapInit (bool testConds, bool runActions) {
    if (runActions) {
        ArenaInit();
    }
    return true;
}

void InitMap () {
    trigger init;
    libNtve_InitLib();
    init = TriggerCreate("ArenaMapInit");
    TriggerAddEventMapInit(init);
}
